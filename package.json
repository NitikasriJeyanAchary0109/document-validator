{
  "name": "rto-precheck",
  "private": true,
  "version": "0.1.0",
  "description": "One-stop pre-appointment document checker for RTO, passport and other Indian government services. Runs entirely in the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "ocr:assets": "node scripts/copy-ocr-assets.mjs",
    "predev": "npm run ocr:assets",
    "prebuild": "npm run ocr:assets"
  },
  "dependencies": {
    "onnxruntime-web": "^1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@gutenye/ocr-models": "^1.4.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^4.1.12"
  }
}
